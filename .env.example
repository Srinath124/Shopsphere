# =============================================================================
# Go N Buy — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.
# =============================================================================

# =============================================================================
# PostgreSQL
# =============================================================================
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=shopsphere
POSTGRES_PASSWORD=changeme_strong_password_here

# Per-service databases
AUTH_DB_NAME=auth_db
AUTH_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${AUTH_DB_NAME}

PRODUCT_DB_NAME=product_db
PRODUCT_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${PRODUCT_DB_NAME}

ORDER_DB_NAME=order_db
ORDER_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${ORDER_DB_NAME}

INVENTORY_DB_NAME=inventory_db
INVENTORY_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${INVENTORY_DB_NAME}

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_URL=jdbc:postgresql://${POSTGRES_HOST}:${POSTGRES_PORT}/${NOTIFICATION_DB_NAME}

# =============================================================================
# Redis
# =============================================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL_SECONDS=3600

# =============================================================================
# RabbitMQ
# =============================================================================
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
RABBITMQ_VHOST=/

# RabbitMQ Exchange/Queue Names
RABBITMQ_ORDERS_EXCHANGE=orders.exchange
RABBITMQ_NOTIFICATIONS_QUEUE=notifications.queue
RABBITMQ_INVENTORY_EVENTS_QUEUE=inventory.events.queue
RABBITMQ_NOTIFICATIONS_DLQ=notifications.dlq

# =============================================================================
# JWT
# =============================================================================
# Generate a strong secret: openssl rand -base64 64
JWT_SECRET=changeme_very_long_and_random_jwt_secret_key_at_least_256_bits_long
JWT_EXPIRATION_MS=3600000
JWT_REFRESH_EXPIRATION_MS=86400000

# =============================================================================
# Service Ports (local development)
# =============================================================================
AUTH_SERVICE_PORT=8081
PRODUCT_SERVICE_PORT=8082
CART_SERVICE_PORT=8083
ORDER_SERVICE_PORT=8084
INVENTORY_SERVICE_PORT=8085
NOTIFICATION_SERVICE_PORT=8086
FRONTEND_PORT=3000

# =============================================================================
# Service URLs (Docker Compose service names)
# =============================================================================
AUTH_SERVICE_URL=http://auth-service:8081
PRODUCT_SERVICE_URL=http://product-service:8082
CART_SERVICE_URL=http://cart-service:8083
ORDER_SERVICE_URL=http://order-service:8084
INVENTORY_SERVICE_URL=http://inventory-service:8085
NOTIFICATION_SERVICE_URL=http://notification-service:8086

# =============================================================================
# Observability
# =============================================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
LOKI_PORT=3100
OTEL_COLLECTOR_PORT=4317
OTEL_COLLECTOR_HTTP_PORT=4318

# OpenTelemetry
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=shopsphere
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local

# =============================================================================
# AWS (for production deployment - do NOT use for local Docker Compose)
# =============================================================================
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# EKS
EKS_CLUSTER_NAME=shopsphere-eks

# ECR / GHCR
CONTAINER_REGISTRY=ghcr.io
CONTAINER_REGISTRY_ORG=your-org

# =============================================================================
# Application Settings
# =============================================================================
SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://shopsphere.local

# AIOps (optional - leave blank to disable LLM integration)
OPENAI_API_KEY=
AIOPS_LLM_ENABLED=false
AIOPS_ANOMALY_THRESHOLD=2.0

# =============================================================================
# Notification Service (simulated email)
# =============================================================================
NOTIFICATION_EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=notifications@shopsphere.com
SMTP_PASSWORD=changeme
NOTIFICATION_FROM_EMAIL=noreply@shopsphere.com
